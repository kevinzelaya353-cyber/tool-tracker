# /srv/tooltracker-prod/shared/.env  (chmod 600, dueño tooltracker). Nunca va a GitHub.
# Secretos: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
PORT=4021
# Nginx está delante (un proxy): necesario para que el límite de intentos use la IP real del cliente.
TRUST_PROXY=1

DATABASE_URL=postgresql://tt_prod:<clave>@localhost:5432/tooltracker_prod?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# La web se sirve desde el mismo dominio; la app nativa no envía Origin.
CORS_ORIGINS=https://herramientas.plexbird.com
API_PUBLIC_URL=https://herramientas.plexbird.com

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/srv/tooltracker-prod/shared/storage
MEDIA_URL_TTL_SEC=600
MEDIA_ORPHAN_TTL_HOURS=24

REPORTS_TZ=America/Tegucigalpa
# Rutas de traslados: clave de OpenRouteService (recomendado en producción; el OSRM público es solo de prueba).
ORS_API_KEY=

# Solo para el primer seed (crear el administrador). Borrar después.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
