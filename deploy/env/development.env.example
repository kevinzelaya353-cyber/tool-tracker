# /srv/tooltracker-dev/shared/.env  (chmod 600, dueño tooltracker). Nunca va a GitHub.
# Development no es público: Nginx lo sirve solo en 127.0.0.1:8082 (acceso por túnel SSH, docs/DEPLOY.md).
# NODE_ENV=production también aquí: es el mismo build que producción, con otra base y otro puerto.
NODE_ENV=production
PORT=4031
TRUST_PROXY=1

DATABASE_URL=postgresql://tt_dev:<clave>@localhost:5432/tooltracker_dev?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:8082
API_PUBLIC_URL=http://localhost:8082

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/srv/tooltracker-dev/shared/storage
MEDIA_URL_TTL_SEC=600
MEDIA_ORPHAN_TTL_HOURS=24

REPORTS_TZ=America/Tegucigalpa
ORS_API_KEY=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
