NODE_ENV=development
PORT=3000
# Proxies de confianza delante de la API (0 si se expone directo; 1 detrás de un Nginx/ALB)
TRUST_PROXY=0
DATABASE_URL=postgresql://tt:tt_dev_password@localhost:5432/tool_tracker?schema=public

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Orígenes permitidos (coma). La app móvil nativa no envía Origin; esto es para Expo web / panel.
CORS_ORIGINS=http://localhost:8081

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tool-photos
S3_ACCESS_KEY=tt_minio
S3_SECRET_KEY=tt_minio_dev_password
# URL de MinIO que alcanza el teléfono (en dev, la IP de tu PC en la LAN, p. ej. http://192.168.1.50:9000)
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL_SEC=600
MEDIA_ORPHAN_TTL_HOURS=24

# Zona horaria para agrupar reportes por mes/año
REPORTS_TZ=UTC

# Solo para prisma/seed.ts
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# Rutas de traslados (mapa). Con clave gratuita de https://openrouteservice.org se usa ORS;
# sin clave se usa OSRM (el servidor público es solo para pruebas). OSRM_URL= vacío desactiva las rutas.
ORS_API_KEY=
# OSRM_URL=https://router.project-osrm.org
