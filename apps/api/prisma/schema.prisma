// Mantener los enums sincronizados con packages/shared/src/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BODEGUERO
  SUPERVISOR
  CHOFER
  LECTOR
}

enum ToolStatus {
  BODEGA
  EN_PROYECTO
  EN_TRANSITO
  EN_MANTENIMIENTO
  DANADA
  EXTRAVIADA
  DADA_DE_BAJA
  DEVUELTA
}

enum ToolOwnership {
  PROPIA
  RENTADA
}

enum DamageKind {
  GOLPE
  FALLA
  PIEZA_FALTANTE
  ROTURA
  DESGASTE
  OTRO
}

enum ToolCondition {
  BUENO
  CON_DETALLES
  NO_OPERATIVA
}

enum RentalStatus {
  ACTIVO
  DEVUELTO
}

enum TransferStatus {
  EN_TRANSITO
  RECIBIDO
}

enum ItemOutcome {
  RECIBIDA
  DANADA
  NO_LLEGO
}

enum ReceptionMethod {
  SESION
  PIN
  SUPERVISION
}

enum LocationType {
  BODEGA
  PROYECTO
}

enum EventType {
  PURCHASE
  DISPATCH
  TRANSFER
  MAINTENANCE_START
  MAINTENANCE_END
  DAMAGE
  LOSS
  RECOVERY
  DECOMMISSION
  RENTAL_RECEIVE
  RENTAL_RETURN
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(120)
  /// null = persona sin acceso a la app (solo se registra como quien entrega o recibe).
  email            String?   @unique @db.VarChar(254)
  /// Usuario corto para iniciar sesión (minúsculas). null = sin acceso o cuenta antigua que entra con correo.
  username         String?   @unique @db.VarChar(30)
  /// Argon2 de la contraseña (ADMIN) o del PIN de 4 dígitos (resto de roles).
  passwordHash     String?   @map("password_hash")
  role             Role      @default(LECTOR)
  active           Boolean   @default(true)
  /// Intentos fallidos seguidos; al llegar al límite se bloquea la cuenta (solo roles con PIN).
  failedLogins     Int       @default(0) @map("failed_logins")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(3)
  /// Vehículo que se preselecciona cuando lleva un traslado (choferes).
  defaultVehicleId String?   @map("default_vehicle_id") @db.Uuid
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  custodyOf           Tool[]           @relation("ToolCustodian")
  transfersDelivered  Transfer[]       @relation("TransferDeliveredBy")
  transfersReceived   Transfer[]       @relation("TransferReceivedBy")
  transfersCreated    Transfer[]       @relation("TransferCreatedBy")
  transfersDriven     Transfer[]       @relation("TransferDriver")
  receptionsConfirmed Transfer[]       @relation("TransferReceptionBy")
  defaultVehicle      Vehicle?         @relation(fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  eventsReported      LifecycleEvent[]
  damageReports       DamageReport[]
  rentalsReceived     Rental[]         @relation("RentalReceivedBy")
  rentalsReturned     Rental[]         @relation("RentalReturnedBy")
  photosUploaded      Photo[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(120)
  type      LocationType
  address   String?      @db.VarChar(250)
  // Punto en el mapa (WGS84); se usa para trazar la ruta de los traslados.
  latitude  Float?
  longitude Float?
  active    Boolean      @default(true)
  startedAt DateTime?    @map("started_at") @db.Date
  closedAt  DateTime?    @map("closed_at") @db.Date
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tools         Tool[]           @relation("ToolCurrentLocation")
  rentals       Rental[]
  transfersFrom Transfer[]       @relation("TransferFrom")
  transfersTo   Transfer[]       @relation("TransferTo")
  events        LifecycleEvent[]

  @@unique([name, type])
  @@map("locations")
}

model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  plate       String   @unique @db.VarChar(15)
  description String?  @db.VarChar(120)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transfers  Transfer[]
  defaultFor User[]

  @@map("vehicles")
}

model ToolCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tools Tool[]

  @@map("tool_categories")
}

model Tool {
  id                 String        @id @default(uuid()) @db.Uuid
  code               String        @unique @db.VarChar(30) // se imprime como QR
  categoryId         String        @map("category_id") @db.Uuid
  brand              String        @db.VarChar(60)
  model              String?       @db.VarChar(60)
  serial             String?       @db.VarChar(80)
  purchasePrice      Decimal       @map("purchase_price") @db.Decimal(12, 2)
  purchaseDate       DateTime      @map("purchase_date") @db.Date
  supplier           String?       @db.VarChar(120)
  /// Rentada: no es un activo de la empresa (precio 0); su historial se lleva por períodos de alquiler.
  ownership          ToolOwnership @default(PROPIA)
  // Campos derivados: SOLO los modifica el service de dominio dentro de una
  // transacción junto con el LifecycleEvent correspondiente.
  // Foto propia de la herramienta (la que aparece en su ficha y en el Excel).
  coverPhotoId       String?       @unique @map("cover_photo_id") @db.Uuid
  status             ToolStatus    @default(BODEGA)
  currentLocationId  String?       @map("current_location_id") @db.Uuid
  currentCustodianId String?       @map("current_custodian_id") @db.Uuid
  statusChangedAt    DateTime      @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category         ToolCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentLocation  Location?        @relation("ToolCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  currentCustodian User?            @relation("ToolCustodian", fields: [currentCustodianId], references: [id], onDelete: SetNull)
  coverPhoto       Photo?           @relation("ToolCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  transferItems    TransferItem[]
  events           LifecycleEvent[]
  photos           Photo[]
  damageReports    DamageReport[]
  rentals          Rental[]

  @@index([status])
  @@index([categoryId])
  @@index([currentLocationId])
  @@index([purchaseDate])
  @@map("tools")
}

model Transfer {
  id                  String           @id @default(uuid()) @db.Uuid
  fromLocationId      String           @map("from_location_id") @db.Uuid
  toLocationId        String           @map("to_location_id") @db.Uuid
  deliveredById       String           @map("delivered_by") @db.Uuid
  receivedById        String           @map("received_by") @db.Uuid
  /// Con chofer: lleva las herramientas y queda a cargo de ellas mientras están en tránsito.
  driverId            String?          @map("driver_id") @db.Uuid
  vehicleId           String?          @map("vehicle_id") @db.Uuid
  status              TransferStatus   @default(RECIBIDO)
  /// Llegada confirmada (en un traslado directo, igual a moved_at).
  receivedAt          DateTime?        @map("received_at") @db.Timestamptz(3)
  /// Quién confirmó la llegada y cómo (su sesión, su PIN en el teléfono del chofer o un supervisor).
  receptionById       String?          @map("reception_by") @db.Uuid
  receptionMethod     ReceptionMethod? @map("reception_method")
  receptionNotes      String?          @map("reception_notes") @db.VarChar(500)
  /// Cuándo llegó la confirmación al servidor (con offline puede ser después de received_at).
  receptionRecordedAt DateTime?        @map("reception_recorded_at") @db.Timestamptz(3)
  movedAt             DateTime         @map("moved_at") @db.Timestamptz(3)
  notes               String?          @db.VarChar(500)
  // Ruta por carretera calculada al registrar el traslado: [[lat, lng], …].
  routeGeometry       Json?            @map("route_geometry")
  routeDistanceM      Int?             @map("route_distance_m")
  routeDurationS      Int?             @map("route_duration_s")
  // Imagen del mapa para la lista (maps/<id>-<hash>.jpg); el hash cambia si cambian los puntos o la ruta.
  mapKey              String?          @map("map_key") @db.VarChar(120)
  createdById         String           @map("created_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  fromLocation Location         @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location         @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  deliveredBy  User             @relation("TransferDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  receivedBy   User             @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  createdBy    User             @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  driver       User?            @relation("TransferDriver", fields: [driverId], references: [id], onDelete: Restrict)
  receptionBy  User?            @relation("TransferReceptionBy", fields: [receptionById], references: [id], onDelete: Restrict)
  vehicle      Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items        TransferItem[]
  photos       Photo[]
  events       LifecycleEvent[]

  @@index([movedAt])
  @@index([status, driverId])
  @@index([status, receivedById])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("transfers")
}

model TransferItem {
  id            String       @id @default(uuid()) @db.Uuid
  transferId    String       @map("transfer_id") @db.Uuid
  toolId        String       @map("tool_id") @db.Uuid
  conditionNote String?      @map("condition_note") @db.VarChar(250)
  /// Resultado al confirmar la recepción (null mientras está en tránsito o en traslados directos).
  outcome       ItemOutcome?
  receptionNote String?      @map("reception_note") @db.VarChar(250)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@unique([transferId, toolId])
  @@index([toolId])
  @@map("transfer_items")
}

model LifecycleEvent {
  id           String      @id @default(uuid()) @db.Uuid
  toolId       String      @map("tool_id") @db.Uuid
  type         EventType
  fromStatus   ToolStatus? @map("from_status") // null solo en PURCHASE y en la primera RENTAL_RECEIVE
  toStatus     ToolStatus  @map("to_status")
  occurredAt   DateTime    @map("occurred_at") @db.Timestamptz(3)
  cost         Decimal?    @db.Decimal(12, 2)
  description  String?     @db.VarChar(500)
  locationId   String?     @map("location_id") @db.Uuid // ubicación resultante (si aplica)
  transferId   String?     @map("transfer_id") @db.Uuid
  reportedById String      @map("reported_by") @db.Uuid
  // clock_timestamp() (no now()): now() es el inicio de la transacción, y una transacción que
  // esperó el bloqueo de la herramienta quedaría ordenada antes que la que se confirmó primero.
  createdAt    DateTime    @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  tool          Tool          @relation(fields: [toolId], references: [id], onDelete: Restrict)
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  transfer      Transfer?     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  reportedBy    User          @relation(fields: [reportedById], references: [id], onDelete: Restrict)
  photos        Photo[]
  // Reporte de daño que provocó este evento (si la herramienta pasó a DANADA por él).
  damageReport  DamageReport?
  rentalReceive Rental?       @relation("RentalReceiveEvent")
  rentalReturn  Rental?       @relation("RentalReturnEvent")

  @@index([toolId, occurredAt])
  @@index([type, occurredAt])
  @@map("lifecycle_events")
}

enum PhotoStage {
  ENTREGA
  RECEPCION
  DEVOLUCION
}

/// Reporte de daño o incidencia. Solo inserción (trigger en BD): un reporte nunca reemplaza a otro.
model DamageReport {
  /// Lo genera la app: un reintento por corte de red devuelve el mismo reporte (no se duplica).
  id               String        @id @db.Uuid
  toolId           String        @map("tool_id") @db.Uuid
  /// Incidencia de un período de alquiler (se asigna sola si la herramienta tiene uno activo).
  rentalId         String?       @map("rental_id") @db.Uuid
  kind             DamageKind
  /// Estado físico observado al reportar.
  condition        ToolCondition
  /// Estado de la herramienta al momento del reporte (para el historial).
  toolStatus       ToolStatus    @map("tool_status")
  description      String        @db.VarChar(500)
  notes            String?       @db.VarChar(500)
  occurredAt       DateTime      @map("occurred_at") @db.Timestamptz(3)
  reportedById     String        @map("reported_by") @db.Uuid
  /// Evento DAMAGE creado por este reporte (la herramienta pasó a DANADA).
  lifecycleEventId String?       @unique @map("lifecycle_event_id") @db.Uuid
  createdAt        DateTime      @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  tool           Tool            @relation(fields: [toolId], references: [id], onDelete: Restrict)
  rental         Rental?         @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  reportedBy     User            @relation(fields: [reportedById], references: [id], onDelete: Restrict)
  lifecycleEvent LifecycleEvent? @relation(fields: [lifecycleEventId], references: [id], onDelete: Restrict)
  photos         Photo[]

  @@index([toolId, occurredAt])
  @@index([rentalId])
  @@map("damage_reports")
}

/// Un período de alquiler de una herramienta rentada: recepción → incidencias → devolución.
/// La recepción no se modifica nunca (trigger en BD); la devolución se registra una sola vez.
model Rental {
  id                   String         @id @db.Uuid
  toolId               String         @map("tool_id") @db.Uuid
  lessor               String         @db.VarChar(120)
  status               RentalStatus   @default(ACTIVO)
  /// Dónde se recibió (bodega o proyecto).
  locationId           String         @map("location_id") @db.Uuid
  receivedAt           DateTime       @map("received_at") @db.Timestamptz(3)
  expectedReturnAt     DateTime?      @map("expected_return_at") @db.Timestamptz(3)
  notes                String?        @db.VarChar(500)
  receptionCondition   ToolCondition  @map("reception_condition")
  receptionDescription String?        @map("reception_description") @db.VarChar(500)
  receptionNotes       String?        @map("reception_notes") @db.VarChar(500)
  receivedById         String         @map("received_by") @db.Uuid
  receiveEventId       String         @unique @map("receive_event_id") @db.Uuid
  returnedAt           DateTime?      @map("returned_at") @db.Timestamptz(3)
  returnCondition      ToolCondition? @map("return_condition")
  returnDescription    String?        @map("return_description") @db.VarChar(500)
  returnNotes          String?        @map("return_notes") @db.VarChar(500)
  returnDifferences    String?        @map("return_differences") @db.VarChar(500)
  returnedById         String?        @map("returned_by") @db.Uuid
  returnEventId        String?        @unique @map("return_event_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tool         Tool            @relation(fields: [toolId], references: [id], onDelete: Restrict)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedBy   User            @relation("RentalReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  returnedBy   User?           @relation("RentalReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)
  receiveEvent LifecycleEvent  @relation("RentalReceiveEvent", fields: [receiveEventId], references: [id], onDelete: Restrict)
  returnEvent  LifecycleEvent? @relation("RentalReturnEvent", fields: [returnEventId], references: [id], onDelete: Restrict)
  incidents    DamageReport[]
  photos       Photo[]

  @@index([toolId, receivedAt])
  @@index([status])
  @@map("rentals")
}

model Photo {
  id               String      @id @default(uuid()) @db.Uuid
  storageKey       String      @unique @map("storage_key") @db.VarChar(300)
  thumbKey         String?     @map("thumb_key") @db.VarChar(300)
  mime             String      @db.VarChar(40)
  sizeBytes        Int         @map("size_bytes")
  width            Int?
  height           Int?
  uploadedById     String      @map("uploaded_by") @db.Uuid
  toolId           String?     @map("tool_id") @db.Uuid
  transferId       String?     @map("transfer_id") @db.Uuid
  lifecycleEventId String?     @map("lifecycle_event_id") @db.Uuid
  damageReportId   String?     @map("damage_report_id") @db.Uuid
  rentalId         String?     @map("rental_id") @db.Uuid
  // Traslados: al entregar o al recibir. Alquileres: al recibir o al devolver.
  stage            PhotoStage?
  /// Dónde estaba el teléfono al tomarla (si dio permiso de ubicación).
  latitude         Float?
  longitude        Float?
  accuracyM        Int?        @map("accuracy_m")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  // Eliminada desde la app: deja de mostrarse, pero se conserva como evidencia para el Excel.
  hiddenAt         DateTime?   @map("hidden_at") @db.Timestamptz(3)

  uploadedBy     User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  tool           Tool?           @relation(fields: [toolId], references: [id], onDelete: SetNull)
  transfer       Transfer?       @relation(fields: [transferId], references: [id], onDelete: SetNull)
  lifecycleEvent LifecycleEvent? @relation(fields: [lifecycleEventId], references: [id], onDelete: SetNull)
  damageReport   DamageReport?   @relation(fields: [damageReportId], references: [id], onDelete: Restrict)
  rental         Rental?         @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  coverOf        Tool?           @relation("ToolCover")

  @@index([transferId])
  @@index([lifecycleEventId])
  @@index([damageReportId])
  @@index([rentalId])
  @@index([toolId])
  @@map("photos")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  family    String    @db.Uuid // para detectar reutilización y revocar toda la familia
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  actorId  String?  @map("actor_id") @db.Uuid
  action   String   @db.VarChar(60)
  entity   String   @db.VarChar(60)
  entityId String?  @map("entity_id") @db.VarChar(64)
  diff     Json?
  ip       String?  @db.VarChar(45)
  at       DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}
