{
  "name": "tool-tracker",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @tt/api dev",
    "dev:mobile": "pnpm --filter @tt/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter @tt/api test:int",
    "test:int:docker": "docker compose --profile test up -d postgres-test && pnpm --filter @tt/api test:int",
    "db:setup": "pnpm --filter @tt/api exec prisma migrate deploy && pnpm db:seed",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @tt/api prisma:migrate",
    "db:seed": "pnpm --filter @tt/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-85393",
        "CVE-2026-93687"
      ]
    }
  }
}
