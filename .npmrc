# React Native/Metro necesita node_modules planos en monorepos pnpm.
node-linker=hoisted
# Copiar (no hardlink) desde el almacén de pnpm: archivos del almacén quedaron marcados como
# "nube" por OneDrive y, enlazados, Metro los descarta como symlinks (bundle de Expo falla).
package-import-method=copy
